  "dialogues": [
    {
      "id": 1,
      "title": "Finding the Train Station",
      "tz": "尋找火車站",
      "tag": "req",
      "sit": "A traveler asks a local for directions.",
      "rA": "Traveler",
      "rB": "Local",
      "lines": [
        [
          "A",
          "Excuse me. How do I get to the train station?"
        ],
        [
          "B",
          "Go straight for two blocks."
        ],
        [
          "A",
          "Do I turn at the traffic light?"
        ],
        [
          "B",
          "Yes. Turn left there."
        ],
        [
          "A",
          "Is the station on the right?"
        ],
        [
          "B",
          "Yes. It is next to the bank."
        ]
      ],
      "tp": "Ask for the bus station instead.",
      "tn": "Replace “train station” with “bus station” and change one direction."
    },
    {
      "id": 2,
      "title": "Taking the Right Bus",
      "tz": "搭對公車",
      "tag": "req",
      "sit": "A traveler checks a bus route with the driver.",
      "rA": "Traveler",
      "rB": "Driver",
      "lines": [
        [
          "A",
          "Does this bus go downtown?"
        ],
        [
          "B",
          "Yes, it does."
        ],
        [
          "A",
          "Does it stop near City Hall?"
        ],
        [
          "B",
          "Yes. Get off at the fifth stop."
        ],
        [
          "A",
          "Do I need to transfer?"
        ],
        [
          "B",
          "No. This bus goes directly there."
        ]
      ],
      "tp": "Ask about the museum instead.",
      "tn": "Replace “City Hall” with “the museum” and choose a new stop number."
    },
    {
      "id": 3,
      "title": "Missing the Stop",
      "tz": "坐過站",
      "tag": "req",
      "sit": "A traveler missed the correct bus stop and asks the driver for help.",
      "rA": "Traveler",
      "rB": "Driver",
      "lines": [
        [
          "A",
          "Excuse me. I missed my stop."
        ],
        [
          "B",
          "Which stop did you need?"
        ],
        [
          "A",
          "Central Station."
        ],
        [
          "B",
          "Get off at the next stop."
        ],
        [
          "A",
          "How can I go back?"
        ],
        [
          "B",
          "Cross the street and take bus twelve."
        ],
        [
          "A",
          "Do I need a new ticket?"
        ],
        [
          "B",
          "No. You can use your transfer."
        ]
      ],
      "tp": "Change the problem to taking the wrong bus.",
      "tn": "Use “I took the wrong bus” and ask how to reach the hotel."
    },
    {
      "id": 4,
      "title": "Buying a Subway Ticket",
      "tz": "購買地鐵票",
      "tag": "ch",
      "sit": "A traveler buys a subway ticket at a station counter.",
      "rA": "Traveler",
      "rB": "Staff",
      "lines": [
        [
          "A",
          "One ticket downtown, please."
        ],
        [
          "B",
          "A single ticket or a day pass?"
        ],
        [
          "A",
          "A single ticket, please."
        ],
        [
          "B",
          "That is three dollars."
        ],
        [
          "A",
          "Which platform do I need?"
        ],
        [
          "B",
          "Platform two, on your left."
        ]
      ],
      "tp": "Buy a day pass instead.",
      "tn": "Replace “single ticket” with “day pass” and ask the price."
    },
    {
      "id": 5,
      "title": "Calling a Taxi",
      "tz": "叫計程車",
      "tag": "ch",
      "sit": "A hotel guest asks staff to arrange transportation.",
      "rA": "Guest",
      "rB": "Hotel Staff",
      "lines": [
        [
          "A",
          "Could you call a taxi for me?"
        ],
        [
          "B",
          "Of course. Where are you going?"
        ],
        [
          "A",
          "To the ferry terminal."
        ],
        [
          "B",
          "What time do you need to leave?"
        ],
        [
          "A",
          "At eight thirty, please."
        ],
        [
          "B",
          "The taxi will meet you at the entrance."
        ]
      ],
      "tp": "Ask for an airport shuttle instead.",
      "tn": "Replace “taxi” with “airport shuttle” and choose a departure time."
    }
  ],
